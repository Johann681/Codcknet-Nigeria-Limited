MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>
MONGODB_DB=codcknet

# Hugging Face API Configuration
# Option 1: Hugging Face Token for Serverless Inference API (Recommended)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
# Optional: specify any supported HF model (e.g., meta-llama/Llama-3.2-3B-Instruct, Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3)
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Option 2: Custom Hugging Face Space URL (Optional, if using a deployed HF Space)
# HF_SPACE_URL=https://your-space.hf.space
# HF_ACCESS_TOKEN=hf_your_token_here
