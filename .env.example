MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>
MONGODB_DB=codcknet

# Hugging Face Space URL without a trailing slash.
HF_SPACE_URL=https://your-space.hf.space

# Server-only token. Keep this out of client-side code and never use NEXT_PUBLIC_.
HF_ACCESS_TOKEN=hf_your_access_token_here
